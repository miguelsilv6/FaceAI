<!doctype html>
<html lang="pt">
<head>
<meta charset="utf-8">
<title>Relatório FaceAI — {{ case.name if case else "Caso" }} — Análise #{{ job.id }}</title>
<style>
  @page { size: A4; margin: 16mm 14mm; @bottom-right { content: "Página " counter(page) " de " counter(pages); font-size: 8pt; color: #666; } }
  body { font-family: "DejaVu Sans", Arial, sans-serif; font-size: 9.5pt; color: #1b1b1b; line-height: 1.4; max-width: 1100px; margin: 0 auto; padding: 16px; }
  h1 { font-size: 17pt; margin: 0 0 4px; }
  h2 { font-size: 12.5pt; border-bottom: 2px solid #1c3d5a; padding-bottom: 3px; margin-top: 22px; color: #1c3d5a; }
  .muted { color: #666; }
  table { border-collapse: collapse; width: 100%; margin: 6px 0; }
  th, td { border: 1px solid #ccc; padding: 4px 6px; text-align: left; vertical-align: top; }
  th { background: #eef2f6; font-weight: 600; }
  table.kv th { width: 30%; }
  .refs { display: flex; flex-wrap: wrap; gap: 10px; }
  .refs figure { margin: 0; width: 120px; text-align: center; font-size: 8pt; }
  .refs img { width: 120px; height: 120px; object-fit: cover; border: 1px solid #999; }
  .seg { page-break-inside: avoid; border: 1px solid #ccc; padding: 8px; margin: 8px 0; display: flex; gap: 10px; }
  .seg img.frame { max-width: 360px; max-height: 220px; }
  .seg img.crop { width: 110px; height: 110px; object-fit: cover; }
  td img { width: 56px; height: 56px; object-fit: cover; }
  .warn { background: #fff4e5; border: 1px solid #f0b46c; padding: 8px 10px; margin: 10px 0; }
  .ok { color: #1a7f37; font-weight: 600; } .bad { color: #b42318; font-weight: 600; } .pend { color: #946200; }
  code { font-size: 8.5pt; }
  tr { page-break-inside: avoid; }
  table.det { font-size: 8pt; table-layout: fixed; }
  table.det td, table.det th { overflow-wrap: anywhere; padding: 3px 4px; }
</style>
</head>
<body>
{% set sec = namespace(n=0) %}
{% macro h(title) %}{% set sec.n = sec.n + 1 %}<h2>{{ sec.n }}. {{ title }}</h2>{% endmacro %}
<h1>Relatório de análise facial em vídeo{% if discover %} — descoberta de pessoas{% endif %}</h1>
<div class="muted">FaceAI v{{ version }} · Gerado em {{ generated_at.strftime("%Y-%m-%d %H:%M:%S") }} UTC</div>

<div class="warn"><strong>Aviso:</strong> os resultados são produzidos por um sistema automático de reconhecimento facial
e são <em>indicativos</em>. Não constituem, por si só, uma identificação conclusiva e têm de ser validados por um
perito, tendo em conta a qualidade das imagens, a iluminação, o ângulo, as oclusões e a possibilidade de falsos positivos e negativos.</div>

{{ h("Caso") }}
<table class="kv">
  <tr><th>Caso</th><td>#{{ case.id }} — {{ case.name }}</td></tr>
  <tr><th>Descrição</th><td>{{ case.description or "—" }}</td></tr>
  <tr><th>Analista</th><td>{{ job.created_by or case.analyst or "—" }}</td></tr>
  <tr><th>Análise</th><td>#{{ job.id }} · estado: {{ {"completed": "concluída", "failed": "falhou", "cancelled": "cancelada", "running": "a decorrer", "queued": "em fila"}.get(job.status.value, job.status.value) }}</td></tr>
  <tr><th>Início / fim (UTC)</th><td>{{ job.started_at.strftime("%Y-%m-%d %H:%M:%S") if job.started_at else "—" }} / {{ job.finished_at.strftime("%Y-%m-%d %H:%M:%S") if job.finished_at else "—" }}</td></tr>
  <tr><th>Resumo</th><td>{{ job.message }}</td></tr>
</table>

{% if discover %}
{{ h("Modo de análise") }}
<p><strong>Descoberta, sem imagem de referência.</strong> Todas as faces detetadas foram seguidas entre frames (tracks)
e os tracks foram agrupados automaticamente em pessoas distintas pela semelhança dos embeddings faciais (distância de
cosseno ao centro do grupo ≤ {{ job.params.threshold }}). O agrupamento é uma ferramenta de triagem: a mesma pessoa
pode surgir em mais de um grupo (ângulos, iluminação, oclusões) e pessoas semelhantes podem ficar juntas. Os grupos
foram{% if audit | selectattr("action", "in", ["person.merged", "track.person_changed"]) | list %} corrigidos manualmente (ver auditoria) e{% endif %} revistos conforme indicado.</p>
{% else %}
{{ h("Imagens de referência") }}
<div class="refs">
{% for r in references %}
  <figure>{% if r.img %}<img src="{{ r.img }}" alt="">{% endif %}
    <figcaption>#{{ r.ref.id }} {{ r.ref.filename }}<br>{{ r.ref.width }}×{{ r.ref.height }} px</figcaption></figure>
{% endfor %}
</div>
{% endif %}

{{ h("Vídeos analisados") }}
<table>
  <tr><th>#</th><th>Local</th><th>Câmara</th><th>Ficheiro</th><th>Tamanho</th><th>Duração</th><th>FPS</th><th>Resolução</th><th>Codec</th></tr>
  {% set frozen = {} %}{% for l in job.params.get("locations") or [] %}{% set _ = frozen.update({l.id: l.name}) %}{% endfor %}
  {% for v in videos %}{% set pl = place(v) %}
  <tr><td>{{ v.id }}</td><td>{{ pl.location_name or "—" }}{% if v.location_id in frozen and frozen[v.location_id] != pl.location_name %}<br><span class="muted">na análise: {{ frozen[v.location_id] }}</span>{% endif %}</td><td>{{ pl.camera_name }}</td><td>{{ v.filename }}</td><td>{{ "{:,}".format(v.size_bytes) }} B</td>
      <td>{{ v.duration_s | ts }}</td><td>{{ "%.2f"|format(v.fps) }}</td><td>{{ v.width }}×{{ v.height }}</td><td>{{ v.codec or "—" }}</td></tr>
  {% endfor %}
</table>
<table class="det">
  <colgroup><col style="width:6%"><col style="width:20%"><col style="width:20%"><col><col style="width:22%"></colgroup>
  <tr><th>#</th><th>Hora real — início</th><th>Hora real — fim</th><th>Método</th><th>Nota</th></tr>
  {% for v in videos %}
  <tr><td>{{ v.id }}</td>
  {% if v.dvr_start %}
      <td>{{ real_at(v, 0) }}</td><td>{{ real_at(v, v.duration_s) }}</td>
      <td>{{ {"ocr": "OCR da data/hora na imagem", "manual": "acerto manual"}.get(v.time_source, v.time_source) }}{% if v.clock_offset_s %} · desvio do DVR {{ "%+.1f"|format(v.clock_offset_s) }} s{% endif %}{% if v.time_source == "ocr" and v.time_calibration %} · {{ v.time_calibration.inliers }}/{{ v.time_calibration.samples|length }} leituras consistentes{% if v.time_calibration.inferred_dates %} ({{ v.time_calibration.inferred_dates }} com data inferida das restantes){% endif %} · erro máx. {{ v.time_calibration.max_residual_s }} s{% if v.dvr_rate != 1.0 %} · taxa {{ "%.4f"|format(v.dvr_rate) }}{% endif %}{% endif %}</td>
      <td>{{ v.time_note or "—" }}</td>
  {% else %}
      <td colspan="4" class="muted">Hora real não acertada — os tempos são relativos ao início do ficheiro.</td>
  {% endif %}</tr>
  {% endfor %}
</table>
{% if videos | selectattr("dvr_start") | list %}<p class="muted">Hora real = relógio do DVR no instante do vídeo (calibrado por OCR da data/hora impressa ou acerto manual) + desvio indicado. Precisão típica: ±1 s. A hora do DVR não é verificada de forma independente.</p>{% endif %}

{{ h("Parâmetros e ambiente") }}
<table class="kv">
  {% if (job.params.get("persons") or [])|length > 1 %}<tr><th>Pessoas procuradas</th><td>{% for p in job.params.persons %}{{ p.id }}. {{ p.label }} ({{ p.reference_ids|length }} referência{{ "s" if p.reference_ids|length != 1 }}){% if not loop.last %} · {% endif %}{% endfor %}</td></tr>{% endif %}
  <tr><th>Modelo de reconhecimento</th><td>{{ job.params.model }}</td></tr>
  <tr><th>Detetor facial</th><td>{{ job.params.detector }}</td></tr>
  {% if discover %}
  <tr><th>Agrupamento em pessoas</th><td>distância de cosseno ao centro do grupo ≤ {{ job.params.threshold }} · embedding do track = média ponderada pela qualidade das suas 5 melhores faces</td></tr>
  {% else %}
  <tr><th>Métrica / limiar</th><td>distância de cosseno ≤ {{ job.params.threshold }} (candidatos até {{ "%.3f"|format(job.params.threshold + job.params.candidate_margin) }})</td></tr>
  {% endif %}
  <tr><th>Amostragem</th><td>{{ job.params.sample_fps }} frames/s · ampliação ×{{ job.params.upscale }}</td></tr>
  <tr><th>Filtros</th><td>face ≥ {{ job.params.min_face_size }} px · confiança do detetor ≥ {{ job.params.min_confidence }} · qualidade ≥ {{ job.params.get("min_quality", 0) }}</td></tr>
  <tr><th>Pré-filtro de movimento</th><td>{% if job.params.get("motion_filter") %}ativo · limiar {{ job.params.motion_threshold }} (fração de píxeis alterados) · frame-chave a cada {{ job.params.keyframe_interval_s }} s{% else %}desativado{% endif %}</td></tr>
  {% if job.params.get("clothing") %}
  <tr><th>Complemento por vestuário</th><td>ativo · deteção de pessoas {{ job.params.get("person_detector") or "yolox_s" }} (YOLOX) · embedding de aparência OSNet-AIN x1.0 (MSMT17) · limiar ReID {{ (job.clothing_summary or {}).get("calibration", {}).get("threshold_used", job.params.get("reid_threshold")) }} · limiar de cor {{ job.params.get("color_threshold") }} · janela temporal ±{{ job.params.get("clothing_window_h") }} h · corpo ≥ {{ job.params.get("min_body_height") }} px</td></tr>
  {% endif %}
  <tr><th>Cascata de deteção</th><td>{% if job.params.get("cascade") and job.params.get("fast_detector") %}1.ª passagem com {{ job.params.fast_detector }}, deteção completa com {{ job.params.detector }} só quando há faces{% else %}desativada{% endif %}</td></tr>
  <tr><th>Tracking</th><td>{% if job.params.get("tracking") %}ativo · intervalo máx. {{ job.params.track_gap_s }} s · {% if discover %}obrigatório no modo descoberta{% else %}match do track pela média das 3 melhores distâncias{% endif %}{% else %}desativado{% endif %}</td></tr>
  <tr><th>Agrupamento em segmentos</th><td>intervalo ≤ {{ job.params.segment_gap_s }} s</td></tr>
  <tr><th>Estatísticas</th><td>{{ job.frames_sampled }} frames amostrados · {{ job.frames_skipped_motion }} saltados (sem movimento) · {{ job.frames_skipped_noface }} saltados (sem faces na 1.ª passagem) · {{ job.frames_processed }} com deteção completa · {{ job.faces_detected }} faces válidas · {% if discover %}{{ job.tracks }} tracks · {{ persons|length }} pessoas distintas · {{ rows|length }} faces guardadas{% else %}{{ job.matches }} correspondências em frames · {{ tracks|length }} tracks com correspondência · {{ candidates }} candidatos/continuações{% endif %}</td></tr>
  <tr><th>Ambiente</th><td>{% for k, v in job.environment.items() %}<code>{{ k }}={{ v }}</code>{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>
</table>

{% if discover %}
{{ h("Pessoas distintas") }}
{% if not persons %}<p><strong>Não foram detetadas faces que cumprissem os filtros definidos.</strong></p>{% endif %}
{% for p in persons %}
<div class="seg">
  {% if p.frame_img %}<img class="frame" src="{{ p.frame_img }}" alt="">{% endif %}
  <div>
    {% if p.crop_img %}<img class="crop" src="{{ p.crop_img }}" alt=""><br>{% endif %}
    <strong>Pessoa #{{ p.person_id }}</strong> ·
    <span class="{{ {'confirmed':'ok','rejected':'bad'}.get(p.review_status, 'pend') }}">{{ {'confirmed':'Confirmada','rejected':'Rejeitada','mixed':'Revisão parcial'}.get(p.review_status, 'Por rever') }}</span><br>
    {{ p.n_tracks }} track(s) · {{ p.n_faces }} faces · {{ p.video_ids|length }} vídeo(s) · tempo visível ≈ {{ "%.1f"|format(p.duration_s) }} s · coesão: dist. máx. ao centro {{ "%.3f"|format(p.max_distance) }}<br>
    {% for a in p.appearances %}
      {{ a.camera_label or a.video_filename or "vídeo #" ~ a.video_id }}: {{ a.start_s | ts }} → {{ a.end_s | ts }}{% if a.real_start %} · <strong>{{ a.real_start }} → {{ a.real_end }}</strong>{% endif %}<br>
    {% endfor %}
  </div>
</div>
{% endfor %}
{% else %}
{{ h("Segmentos de aparição") }}
{% if not segments %}<p><strong>Não foram encontradas correspondências acima do limiar definido.</strong></p>{% endif %}
{% for s in segments %}
<div class="seg">
  {% if s.frame_img %}<img class="frame" src="{{ s.frame_img }}" alt="">{% endif %}
  <div>
    {% if s.crop_img %}<img class="crop" src="{{ s.crop_img }}" alt=""><br>{% endif %}
    <strong>{{ s.camera_label if s.video else "vídeo #" ~ s.video_id }}</strong>{% if s.video %} <span class="muted">({{ s.video.filename }})</span>{% endif %}<br>
    {{ s.start_s | ts }} → {{ s.end_s | ts }} ({{ "%.1f"|format(s.duration_s) }} s)<br>
    {% if s.real_start %}<strong>Hora real: {{ s.real_start }} → {{ s.real_end }}</strong><br>{% endif %}
    {{ s.count }} deteção(ões) · melhor similaridade {{ "%.3f"|format(s.best_similarity) }} (distância {{ "%.3f"|format(s.best_distance) }})
  </div>
</div>
{% endfor %}
{% endif %}

{% if job.params.get("tracking") %}
{{ h("Tracks" if discover else "Tracks com correspondência") }}
<p class="muted">Um track agrupa as deteções da mesma face em frames consecutivos. {% if discover %}A distância é a do track ao centro do grupo da sua pessoa.{% else %}A decisão usa a média das (até) 3 melhores distâncias do track.{% endif %}</p>
{% if not tracks %}<p>Nenhum track{% if not discover %} com correspondência{% endif %}.</p>{% else %}
<table class="det">
  <colgroup><col style="width:62px"><col style="width:7%"><col><col style="width:14%"><col style="width:14%"><col style="width:8%"><col style="width:11%"><col style="width:9%"><col style="width:12%"></colgroup>
  <tr><th>Face</th><th>Track</th><th>Local · Câmara</th><th>Início</th><th>Fim</th><th>Faces</th><th>{{ "Dist. ao centro" if discover else "Dist. track" }}</th><th>Qualid.</th><th>Revisão</th></tr>
  {% for x in tracks %}
  <tr><td>{% if x.crop_img %}<img src="{{ x.crop_img }}" alt="">{% endif %}</td><td>#{{ x.t.id }}{% if x.t.person_id %}<br>{% if discover %}P{{ x.t.person_id }}{% else %}{{ (job.params.persons | selectattr("id", "equalto", x.t.person_id) | map(attribute="label") | first) or ("P" ~ x.t.person_id) }}{% endif %}{% endif %}</td><td>{{ place(x.video).camera_label if x.video else x.t.video_id }}</td>
      <td>{{ x.t.start_s | ts }}{% if x.real_start %}<br><strong>{{ x.real_start }}</strong>{% endif %}</td><td>{{ x.t.end_s | ts }}{% if x.real_end %}<br><strong>{{ x.real_end }}</strong>{% endif %}</td><td>{{ x.t.n_faces }}</td><td>{{ "%.3f"|format(x.t.track_distance) }}</td><td>{{ "%.2f"|format(x.t.best_quality) }}</td>
      <td class="{{ {'confirmed':'ok','rejected':'bad'}.get(x.t.review_status.value, 'pend') }}">{{ {'confirmed':'Confirmado','rejected':'Rejeitado'}.get(x.t.review_status.value, 'Por rever') }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

{{ h("Faces guardadas" if discover else "Correspondências detalhadas") }}
<p class="muted">Revisão humana: <span class="ok">{{ review_counts.confirmed }} confirmadas</span> ·
  <span class="bad">{{ review_counts.rejected }} rejeitadas</span> · <span class="pend">{{ review_counts.pending }} por rever</span>.
  {% if rows|length > max_images %}Só os primeiros {{ max_images }} recortes estão incluídos como imagem.{% endif %}</p>
<table class="det">
  <colgroup><col style="width:62px"><col style="width:6%"><col><col style="width:14%"><col style="width:8%"><col style="width:8%"><col style="width:8%"><col style="width:7%"><col style="width:7%"><col style="width:12%"></colgroup>
  <tr><th>Face</th><th>#</th><th>Local · Câmara</th><th>Tempo</th><th>Frame</th><th>{{ "Pessoa" if discover else "Simil." }}</th><th>Dist.{% if discover %} centro{% endif %}</th><th>Q</th><th>Track</th><th>Revisão</th></tr>
  {% for r in rows %}
  <tr><td>{% if r.crop_img %}<img src="{{ r.crop_img }}" alt="">{% endif %}</td><td>{{ r.detection_id }}</td><td>{{ (r.location_name ~ " · " ~ r.camera_name) if r.location_name else (r.camera_name or r.video_filename) }}</td>
      <td>{{ r.timestamp }}{% if r.real_time %}<br><strong>{{ r.real_time }}</strong>{% endif %}</td><td>{{ r.frame_index }}</td><td>{% if discover %}{{ ("#" ~ r.person_id) if r.person_id != "" else "—" }}{% else %}{{ "%.3f"|format(r.similarity) }}{% if r.person_label %}<br><strong>{{ r.person_label }}</strong>{% endif %}{% endif %}</td><td>{{ "%.3f"|format(r.distance) }}</td>
      <td>{{ "%.2f"|format(r.quality) }}</td><td>{{ ("#" ~ r.track_id) if r.track_id != "" else "—" }}</td>
      <td class="{{ {'confirmed':'ok','rejected':'bad'}.get(r.review_status, 'pend') }}">{{ {'confirmed':'Confirmada','rejected':'Rejeitada'}.get(r.review_status, 'Por rever') }}
        {% if r.reviewed_by %}<br><span class="muted">{{ r.reviewed_by }}</span>{% endif %}{% if r.review_note %}<br>{{ r.review_note }}{% endif %}</td></tr>
  {% endfor %}
</table>

{% if job.params.get("clothing") %}
{{ h("Correspondências por vestuário — evidência complementar") }}
<div class="warn"><strong>Evidência complementar e indicativa.</strong> Estas aparições foram encontradas pela
semelhança do vestuário (embedding de aparência do corpo e cores do tronco/pernas) com o corpo da pessoa nos frames
em que a face teve correspondência. Não identificam a pessoa: roupa semelhante (fardas, roupa escura ou comum) pode
pertencer a outra pessoa, e a roupa pode mudar (casaco, mochila). Cada aparição tem de ser revista por um perito.</div>
{% set cs = job.clothing_summary or {} %}
<p>{{ job.clothing_samples }} amostra(s) de vestuário{% if cs.get("gallery_colors") %} — tronco <strong>{{ cs.gallery_colors.tronco }}</strong>, pernas <strong>{{ cs.gallery_colors.pernas }}</strong>{% endif %} ·
{{ cs.get("body_tracks", 0) }} tracks de corpo analisados · {{ cs.get("known_negatives", 0) }} corpos com face de outra pessoa (negativos conhecidos) ·
{{ cs.get("excluded_by_window", 0) }} excluídos pela janela temporal.
{% if cs.get("calibration") %}Calibração no caso: limiar usado {{ cs.calibration.threshold_used }}{% if cs.calibration.get("negatives_min") is not none %} · distância mínima dos negativos {{ cs.calibration.negatives_min }}{% endif %}{% if cs.calibration.get("positives_median") is not none %} · mediana entre amostras {{ cs.calibration.positives_median }}{% endif %}.{% endif %}
{% if cs.get("note") %}<br><strong>{{ cs.note }}</strong>{% endif %}</p>
{% if clothing %}
<table class="det">
  <colgroup><col style="width:62px"><col style="width:18%"><col><col style="width:16%"><col style="width:16%"><col style="width:9%"><col style="width:9%"><col style="width:12%"></colgroup>
  <tr><th>Corpo</th><th>Evidência</th><th>Local · Câmara</th><th>Início</th><th>Fim</th><th>Dist. ReID</th><th>Dist. cor</th><th>Revisão</th></tr>
  {% for x in clothing %}
  <tr><td>{% if x.crop_img %}<img src="{{ x.crop_img }}" alt="" style="height:80px;width:auto">{% endif %}</td>
      <td>{{ "Amostra (face + vestuário)" if x.t.evidence == "face+vestuário" else "Só vestuário" }}<br><span class="muted">tronco {{ (x.t.colors or {}).get("tronco", "?") }}, pernas {{ (x.t.colors or {}).get("pernas", "?") }}</span>{% if x.t.note %}<br><span class="muted">{{ x.t.note }}</span>{% endif %}</td>
      <td>{{ place(x.video).camera_label if x.video else x.t.video_id }}</td>
      <td>{{ x.t.start_s | ts }}{% if x.real_start %}<br><strong>{{ x.real_start }}</strong>{% endif %}</td>
      <td>{{ x.t.end_s | ts }}{% if x.real_end %}<br><strong>{{ x.real_end }}</strong>{% endif %}</td>
      <td>{{ "%.3f"|format(x.t.reid_distance or 0) }}</td><td>{{ "%.3f"|format(x.t.color_distance or 0) }}</td>
      <td class="{{ {'confirmed':'ok','rejected':'bad'}.get(x.t.review_status.value, 'pend') }}">{{ {'confirmed':'Confirmado','rejected':'Rejeitado'}.get(x.t.review_status.value, 'Por rever') }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

{{ h("Registo de auditoria do caso") }}
<p class="muted">O utilizador é a conta autenticada (login com password e MFA). Eventos anteriores à introdução das contas registam o nome indicado livremente no navegador, sem IP.</p>
<table>
  <tr><th>#</th><th>Data/hora (UTC)</th><th>Utilizador</th><th>IP</th><th>Ação</th><th>Detalhes</th></tr>
  {% for e in audit %}
  <tr><td>{{ e.id }}</td><td>{{ e.timestamp.strftime("%Y-%m-%d %H:%M:%S") }}</td><td>{{ e.actor }}</td><td>{{ e.ip or "—" }}</td><td>{{ e.action }}</td>
      <td><code>{{ e.details | tojson }}</code></td></tr>
  {% endfor %}
</table>
</body>
</html>
