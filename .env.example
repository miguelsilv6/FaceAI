# FaceAI — configuração (copie para .env; todas as linhas são opcionais).
# Lista completa no README, secção "Configuração (variáveis de ambiente)".

# --- Mais usadas -------------------------------------------------------------
# MFA obrigatório para todos (configurado no primeiro login)
#FACEAI_REQUIRE_MFA=true

# Atrás do Cloudflare Tunnel: IP real na auditoria e nos bloqueios.
# Só com a porta 8000 fechada ao exterior.
#FACEAI_TRUST_PROXY=cloudflare
#FACEAI_ALLOWED_ORIGINS=https://faceai.exemplo.pt

# Pasta do servidor para importar pastas de vídeos (monte-a também em docker-compose.yml, só de leitura)
#FACEAI_IMPORT_DIR=/import

# Limitar o CPU usado pelas análises (0 = todos os núcleos)
#FACEAI_CPU_THREADS=4

# --- Evidência ---------------------------------------------------------------
# 0 = manter no servidor os originais convertidos (.sec, formatos que o browser não abre)
#FACEAI_REMOVE_ORIGINALS=1
# Cópias de reprodução (só para ver no browser; criadas ao abrir o vídeo): altura máxima,
# qualidade H.264 (CRF, maior = mais pequena) e dias sem uso até serem apagadas (0 = nunca)
#FACEAI_PLAYBACK_MAX_HEIGHT=720
#FACEAI_PLAYBACK_CRF=28
#FACEAI_PLAYBACK_TTL_DAYS=14
# Ordem da data no relógio impresso pelo DVR: DMY, MDY ou YMD
#FACEAI_CLOCK_DATE_ORDER=DMY

# --- Avançado ----------------------------------------------------------------
# Chave dos segredos MFA (vazio = data/secret.key, incluída no backup)
#FACEAI_SECRET_KEY=
#FACEAI_SESSION_IDLE_MINUTES=30
#FACEAI_SESSION_MAX_HOURS=12
#FACEAI_DISK_WARN_PERCENT=80
#FACEAI_DISK_CRITICAL_PERCENT=90
#FACEAI_DISK_MIN_FREE_GB=2
#FACEAI_LOG_FORMAT=json
